local function setActiveTab(activeBtn, activeFrame, inactiveBtns, inactiveFrames)
    activeBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 220)
    for _, b in ipairs(inactiveBtns) do b.BackgroundColor3 = Color3.fromRGB(50, 50, 60) end
    activeFrame.Visible = true
    for _, f in ipairs(inactiveFrames) do f.Visible = false end
end

