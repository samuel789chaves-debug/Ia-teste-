-- ===== NOTIFICAÇÃO =====
local notifyBindable = Instance.new("BindableFunction")
local function notify(title, text, duration)
    StarterGui:SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration or 5
    })
end

-- ===== CHAT =====
local function Chat(msg)
    pcall(function()
        TextChatService.TextChannels.RBXGeneral:SendAsync(msg)
    end)
end

local function SendMessage(msg)
    local elapsed = tick() - timeSinceLastMessage
    if elapsed < minMessageCooldown then
        task.wait(minMessageCooldown - elapsed)
    end
    Chat(msg)
    timeSinceLastMessage = tick()
end

-- ===== UTILIDADES =====
local function GetLetterIndex(letter)
    for i, v in ipairs(alphabet) do
        if v == letter then return i end
    end
    return nil
end

local function IsOnCooldown(player)
    return table.find(userCooldowns, player.Name) ~= nil
end

local function AddCooldown(player)
    table.insert(userCooldowns, player.Name)
    task.delay(cooldownTime, function()
        local i = table.find(userCooldowns, player.Name)
        if i then table.remove(userCooldowns, i) end
    end)
end

-- ===== ENVIA A LISTA DE TEMAS (usado no botão) =====
local function BuildThemeList()
    local lines = {}
    for _, letter in ipairs(alphabet) do
        table.insert(lines, letter..") "..iaData[letter].theme)
    end
    return lines
end

local function SendThemeList()
    if not iaActive then
        notify("IA desativada", "Ative a IA antes de usar esta função")
        return
    end
    SendMessage("📚 | Temas disponíveis (digite a letra no chat):")
    task.wait(1)
    -- Agrupa em blocos para não estourar o limite do chat
    local lines = BuildThemeList()
    local chunk = {}
    local chunkSize = 0
    for _, line in ipairs(lines) do
        if chunkSize + #line + 2 > 180 then
            SendMessage("📚 | "..table.concat(chunk, " | "))
            task.wait(1.5)
            chunk = {}
            chunkSize = 0
        end
        table.insert(chunk, line)
        chunkSize = chunkSize + #line + 2
    end
    if #chunk > 0 then
        SendMessage("📚 | "..table.concat(chunk, " | "))
    end
end

-- ===== LÓGICA PRINCIPAL =====
local function ProcessMessage(player, message)
    if not iaActive then return end
    if player == localPlayer then return end -- a IA não responde a si mesma

    -- normaliza
    local msg = string.upper(string.gsub(message, "%s", ""))
    if #msg == 0 or #msg > 2 then return end -- só aceita 1 letra

    local firstChar = string.sub(msg, 1, 1)

    -- Se o jogador está aguardando resposta (A/B/C)
    local awaiting = awaitingPlayers[player.Name]
    if awaiting then
        if firstChar == "A" or firstChar == "B" or firstChar == "C" then
            local optionIndex = (firstChar == "A") and 1 or (firstChar == "B") and 2 or 3
            local themeData = iaData[awaiting]
            if not themeData then
                awaitingPlayers[player.Name] = nil
                return
            end
            local opt = themeData.options[optionIndex]
            if not opt then return end
            awaitingPlayers[player.Name] = nil
            SendMessage("🤖 | "..player.DisplayName..", aqui está a resposta:")
            task.wait(1)
            SendMessage("💡 | "..opt.a)
            task.wait(1)
            SendMessage("📚 | Quer saber mais? Digite outra letra (A-Z).")
        else
            SendMessage("🤖 | "..player.DisplayName..", escolha A, B ou C para continuar.")
        end
        return
    end

    -- Se não está aguardando, verifica se é uma letra de tema (A-Z)
    if table.find(alphabet, firstChar) then
        if IsOnCooldown(player) then
            return
        end
        AddCooldown(player)

        local themeData = iaData[firstChar]
        if not themeData then return end

        awaitingPlayers[player.Name] = firstChar

        SendMessage("🤖 | Olá, "..player.DisplayName.."! Você escolheu a letra "..firstChar..": "..themeData.theme)
        task.wait(1)
        SendMessage("❓ | O que você quer saber?")
        task.wait(1)
        for i = 1, 3 do
            local opt = themeData.options[i]
            SendMessage(alphabet[i]..") "..opt.q)
            task.wait(1)
        end
        SendMessage("👉 | Digite A, B ou C para escolher.")
    end
end

