local chatConnection = TextChatService.MessageReceived:Connect(function(textChatMessage)
    if not iaActive then return end
    if not textChatMessage.TextSource then return end
    local player = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
    if not player then return end
    ProcessMessage(player, textChatMessage.Text)
end)

