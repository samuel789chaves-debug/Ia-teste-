local function startAskerSession(player)
    currentAskerToken = currentAskerToken + 1
    local myToken = currentAskerToken
    currentAsker = { name = player.Name, display = player.DisplayName }
    
    task.delay(askTimeout, function()
        if currentAskerToken == myToken and currentAsker and currentAsker.name == player.Name then
            SendMessage("⏰ | O tempo de "..player.DisplayName.." acabou! Outro jogador já pode perguntar.")
            currentAsker = nil
            awaitingPlayers[player.Name] = nil
        end
    end)
end

local function clearAskerSession()
    currentAskerToken = currentAskerToken + 1
    currentAsker = nil
end

-- ===== LÓGICA PRINCIPAL =====
local function ProcessMessage(player, message)
    if not iaActive then return end
    if player == localPlayer then return end
    
    local msg = string.upper(string.gsub(message, "%s", ""))
    if #msg == 0 or #msg > 2 then return end
    local firstChar = string.sub(msg, 1, 1)

    local isMyTurn = currentAsker and currentAsker.name == player.Name

    -- === CASO 1: é o perguntador atual e está escolhendo uma opção ===
    if isMyTurn and awaitingPlayers[player.Name] then
        local optIndex = optionLetterToIndex(firstChar)
        if optIndex then
            local themeLetter = awaitingPlayers[player.Name]
            local themeData = iaData[themeLetter]
            awaitingPlayers[player.Name] = nil
            clearAskerSession()
            if not themeData then return end
            local opt = themeData.options[optIndex]
            if not opt then return end
            SendMessage("🤖 | "..player.DisplayName..", aqui está a resposta:")
            task.wait(1)
            SendMessage("💡 | "..opt.a)
            task.wait(1)
            SendMessage("📚 | Quer saber mais? Digite outra letra (A-Z).")
            return
        else
            SendMessage("🤖 | "..player.DisplayName..", escolha uma letra de A até F.")
            return
        end
    end

    -- === CASO 2: já tem alguém perguntando (não é ele) → bloqueia ===
    if currentAsker and currentAsker.name ~= player.Name then
        SendMessage("⏳ | Aguarde! "..currentAsker.display.." está escolhendo. Uma pergunta por vez.")
        return
    end

    -- === CASO 3: inicia nova pergunta ===
    if table.find(alphabet, firstChar) then
        if IsOnCooldown(player) then return end
        AddCooldown(player)
        local themeData = iaData[firstChar]
        if not themeData then return end

        awaitingPlayers[player.Name] = firstChar
        startAskerSession(player)

        SendMessage("🤖 | Olá, "..player.DisplayName.."! Letra "..firstChar..": "..themeData.theme)
        task.wait(1)
        SendMessage("❓ | O que você quer saber? (Você tem "..askTimeout.." segundos)")
        task.wait(1)
        for i = 1, 6 do
            local opt = themeData.options[i]
            if opt then
                SendMessage(optionLetters[i]..") "..opt.q)
                task.wait(1)
            end
        end
        SendMessage("👉 | Digite uma letra de A até F para escolher.")
    end
end

-- ===== LISTENER DO CHAT =====
local function StartListening()
    if chatConnection then return end
    chatConnection = TextChatService.MessageReceived:Connect(function(textChatMessage)
        if not textChatMessage.TextSource then return end
        local player = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
        if not player then return end
        if player == localPlayer then
            handleOwnMessage(textChatMessage.Text)
            return
        end
        if not iaActive then return end
        ProcessMessage(player, textChatMessage.Text)
    end)
end
