}

local function SendInstructions()
    if not iaActive then notify("IA desativada", "Ative a IA primeiro") return end
    for _, msg in ipairs(instructionMessages) do
        SendMessage(msg)
        task.wait(1.2)
    end
end

local function SendThemeList()
    if not iaActive then notify("IA desativada", "Ative a IA primeiro") return end
    SendMessage("📚 | Temas disponíveis (digite a letra no chat):")
    task.wait(1)
    local chunk, chunkSize = {}, 0
    for _, letter in ipairs(alphabet) do
        local line = letter..") "..iaData[letter].theme
        if chunkSize + #line + 3 > 180 then
            SendMessage("📚 | "..table.concat(chunk, " | "))
            task.wait(1.5)
            chunk, chunkSize = {}, 0
        end
        table.insert(chunk, line)
        chunkSize = chunkSize + #line + 3
    end
    if #chunk > 0 then SendMessage("📚 | "..table.concat(chunk, " | ")) end
end

