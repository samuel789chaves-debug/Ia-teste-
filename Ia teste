-- ===== CHAT =====
local function Chat(msg)
    pcall(function()
        local channel = TextChatService.TextChannels.RBXGeneral
        if not channel then
            for _, ch in pairs(TextChatService.TextChannels:GetChildren()) do
                if ch:IsA("TextChannel") then channel = ch break end
            end
        end
        if channel then channel:SendAsync(msg) end
    end)
end

-- ===== ANTI-FILTRO =====
local function makeVariation(text, attempt)
    local v = text
    if attempt == 1 then
        v = string.gsub(v, "[%|%?%.%!%,]", "")
        v = string.gsub(v, "  ", " ")
    elseif attempt == 2 then
        v = string.gsub(v, "á", "a")
        v = string.gsub(v, "é", "e")
        v = string.gsub(v, "í", "i")
        v = string.gsub(v, "ó", "o")
        v = string.gsub(v, "ú", "u")
        v = string.gsub(v, "ã", "a")
        v = string.gsub(v, "õ", "o")
        v = string.gsub(v, "ç", "c")
        v = string.gsub(v, "â", "a")
        v = string.gsub(v, "ê", "e")
        v = string.gsub(v, "ô", "o")
    else
        v = v .. " ✨"
    end
    return v
end

local function SendMessage(msg, attempts, prepend)
    attempts = attempts or 0
    local elapsed = tick() - timeSinceLastMessage
    if elapsed < minMessageCooldown then task.wait(minMessageCooldown - elapsed) end
    local entry = {text = msg, attempts = attempts}
    if prepend then
        table.insert(pendingMessages, 1, entry)
    else
        table.insert(pendingMessages, entry)
    end
    while #pendingMessages > 30 do table.remove(pendingMessages, 1) end
    Chat(msg)
    timeSinceLastMessage = tick()
end

local function handleOwnMessage(received)
    if #pendingMessages == 0 then return end
    local p = pendingMessages[1]
    local receivedClean = string.gsub(received, "#", "")
    local originalClean = string.gsub(p.text, "#", "")
    local isFiltered = string.find(received, "#") ~= nil
        or math.abs(#receivedClean - #originalClean) > 5
    table.remove(pendingMessages, 1)
    if isFiltered and p.attempts < MAX_RESEND then
        local variant = makeVariation(p.text, p.attempts + 1)
        task.wait(2)
        SendMessage(variant, p.attempts + 1, true)
        print("[Anti-filtro] Reenviando mensagem filtrada (tentativa "..(p.attempts + 1)..")")
    end
end

-- ===== UTIL =====
local function IsOnCooldown(player)
    return table.find(userCooldowns, player.Name) ~= nil
end

local function AddCooldown(player)
    table.insert(userCooldowns, player.Name)
    task.delay(cooldownTime, function()
        local i = table.find(userCooldowns, player.Name)
        if i then table.remove(userCooldowns, i) end
    end)
end

local function optionLetterToIndex(letter)
    for i, v in ipairs(optionLetters) do
        if v == letter then return i end
    end
    return nil
end

